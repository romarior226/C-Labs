<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button
                Content=" Add numbers "
                Height=" 50"
                VerticalAlignment="Top"
                Margin="100,75,610,0"
                Click="AddNumbers" />
        <Button
            Content=" Clear "
            Height=" 50"
            VerticalAlignment="Top"
            Margin="335,75,374,0"
            Click="Clear"
            />
        <TextBox
            x:Name="TextBoxForNumbers"
            TextWrapping="Wrap"
            Height="100"
            HorizontalAlignment="Left"
            Width="326"
            Margin="100,192,0,142" />
        <TextBox
            x:Name="TextBoxForCount"
            Height="20"
            HorizontalAlignment="Left"
            Width="326"
            Margin="100,157,0,257" />
        <ListBox
            x:Name="Result"
            Height="200"
            Width="300"
            HorizontalAlignment="Right"
            Margin="0 , 0 30 , 0" />
        <Label
            x:Name="Label"
            Content="MyLable"
            Height="30"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0 , 125 , 300 , 0" />
        <Label
            x:Name="Label_Copy"
            Content="List"
            Height="30"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Margin="470,82,0,0" RenderTransformOrigin="0.916,0.62" />


    </Grid>
</Window>